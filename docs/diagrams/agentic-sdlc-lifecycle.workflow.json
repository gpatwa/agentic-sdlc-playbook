  "cards": [
    {
      "dot": "cyan",
      "title": "Narrow roles, not one big agent",
      "items": [
        "Each stage owns one input, one output, one decision",
        "Handoff is a written artefact, never a shared context window",
        "24 roles in the full spec; this shows the always-run path"
      ]
    },
    {
      "dot": "rose",
      "title": "A failed gate sends work back",
      "items": [
        "Never forward \u2014 the owning stage fixes it, not the reviewer",
        "Real case: Security found two test-coverage gaps, closed in 8 minutes",
        "Bounded: 2 retries per stage before it escalates to a human"
      ]
    },
    {
      "dot": "emerald",
      "title": "Post-Launch closes the loop",
      "items": [
        "Carry-forward items feed the next slice's plan directly",
        "Not a retro filed and forgotten",
        "Pipeline telemetry (trace.json) refreshes here too"
      ]
    }
  ]
