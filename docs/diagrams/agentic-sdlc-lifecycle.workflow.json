{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "Agentic SDLC Lifecycle",
    "output": "agentic-sdlc.html",
    "animation": "trace",
    "quality_profile": "showcase",
    "views": [
      {
        "id": "core-path",
        "label": "Ask to shipped",
        "focus": [
          "intake",
          "scope_review",
          "discovery",
          "ux_ui_design",
          "architecture",
          "implementation",
          "qa",
          "security",
          "release_gate",
          "post_launch"
        ],
        "note": "The stages that always run, in sequence, for a slice with no user-facing surface skipped."
      },
      {
        "id": "gate-rework",
        "label": "A gate sends work back",
        "focus": [
          "qa",
          "security",
          "rework",
          "implementation"
        ],
        "note": "A failed gate returns the slice to the owning stage, never forward \u2014 the real Security-to-rework path this pipeline has produced twice."
      },
      {
        "id": "close-the-loop",
        "label": "Post-Launch closes the loop",
        "focus": [
          "post_launch",
          "intake"
        ],
        "note": "Learnings become the next slice's plan, not a filed report nobody reads."
      }
    ]
  },
  "lanes": [
    {
      "id": "core",
      "label": "Orchestrator & Planning"
    },
    {
      "id": "discovery_track",
      "label": "Discovery & Design"
    },
    {
      "id": "delivery_track",
      "label": "Delivery"
    },
    {
      "id": "exceptions",
      "label": "Gate Rework",
      "variant": "exception"
    }
  ],
  "phases": [
    {
      "id": "frame",
      "label": "Frame the ask",
      "fromCol": 0,
      "toCol": 1
    },
    {
      "id": "design",
      "label": "Design & Plan",
      "fromCol": 2,
      "toCol": 2
